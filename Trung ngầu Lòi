local function isImportant(obj)
    if obj:FindFirstAncestorOfClass("Model") and obj:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then
        return true
    end
    local name = string.lower(obj.Name)
    if name:find("egg") or name:find("trung") or name:find("plot") or 
       name:find("base") or name:find("claim") or name:find("pen") or name:find("nest") then
        return true
    end
    return false
end

createNeonButton("🔥 Fix Lag Vô Cực ☠️ (Xóa Map)", Color3.fromRGB(180, 20, 40), Color3.fromRGB(255, 60, 80), function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 0
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("DepthOfFieldEffect") or 
           v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or 
           v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or 
           v:IsA("Atmosphere") or v:IsA("Sky") then
            v:Destroy()
        end
    end

    if Terrain then Terrain:Clear() end

    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
            v.CastShadow = false
            
            if not isImportant(v) then
                v.Transparency = 1
                local name = string.lower(v.Name)
                if name:find("fence") or name:find("wall") or name:find("shop") or name:find("decor") or name:find("tree") then
                    v.CanCollide = false
                end
            else
                v.Transparency = 0
                v.Color = Color3.fromRGB(150, 150, 150)
            end
        end
    end
end)

createNeonButton("⚡ Fix Lag Ngon Lành (Smooth map+Ẩn Player)", Color3.fromRGB(120, 20, 30), Color3.fromRGB(220, 50, 70), function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
            v:Destroy()
        end
    end

    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Sparkles") or v:IsA("Fire") or v:IsA("Smoke") then
            v:Destroy()
        elseif v:IsA("Texture") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Material = Enum.Material.SmoothPlastic
            v.Reflectance = 0
            v.CastShadow = false
        end
    end

    local function hideOtherPlayer(player)
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Transparency = 1
                elseif part:IsA("Decal") or part:IsA("Texture") or part:IsA("Accessory") or part:IsA("Shirt") or part:IsA("Pants") then
                    part:Destroy()
                end
            end
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        hideOtherPlayer(player)
    end

    Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            hideOtherPlayer(player)
        end)
    end)
end)

